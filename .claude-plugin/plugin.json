{
 "name": "simple-english",
 "displayName": "Simple English 中文版",
 "description": "按中文技術表達規範（C01–C24）撰寫或改寫中文技術文字：保留事實與邏輯邊界，區分事實/推斷/未知，不補造資訊，一個概念一個術語，指明執行者，條件先於動作，保護機器可讀內容。",
 "version": "2.2.0",
 "author": {
 "name": "TranChinese"
 },
 "homepage": "https://github.com/TranChinese/SimpleEnglish-zh",
 "repository": "https://github.com/TranChinese/SimpleEnglish-zh",
 "license": "MIT",
 "keywords": [
 "technical-writing",
 "documentation",
 "ste",
 "asd-ste100"
 ],
 "hooks": {
 "SessionStart": [
 {
 "hooks": [
 {
 "type": "command",
 "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/hooks/simple-english-activate.js\"",
 "timeout": 5,
 "statusMessage": "Loading Simple English..."
 }
 ]
 }
 ],
 "PostToolUse": [
 {
 "matcher": "Write|Edit",
 "hooks": [
 {
 "type": "command",
 "command": "sh \"${CLAUDE_PLUGIN_ROOT}/src/hooks/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/src/hooks/lint_hook.py\"",
 "timeout": 10,
 "statusMessage": "Simple English: checking the file..."
 }
 ]
 }
 ],
 "Stop": [
 {
 "hooks": [
 {
 "type": "command",
 "command": "sh \"${CLAUDE_PLUGIN_ROOT}/src/hooks/run-python.sh\" \"${CLAUDE_PLUGIN_ROOT}/src/hooks/lint_hook.py\"",
 "timeout": 10
 }
 ]
 }
 ]
 }
}
